{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env.local scripts/dev.js",
    "start": "node --env-file=.env.local src/app.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --env-file=.env.local",
    "db:migrate": "node --env-file=.env.local db/migrate.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "@vercel/functions": "^1.1.0"
  },
  "devDependencies": {
    "eslint": "^9.6.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0"
  }
}
