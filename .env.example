# Database (injected by Vercel Neon integration)
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# Local development only (copy to .env.local and fill in)
# PORT=3000
# DATABASE_URL=postgres://user:pass@localhost:5432/todo_dev?sslmode=disable

# Optional: for integration tests against a real database
# TEST_DATABASE_URL=postgres://user:pass@host/test_db?sslmode=require